        "company_target": {
          "default": "",
          "title": "Company Target",
          "type": "string"
        },
        "freshness_window": {
          "minLength": 1,
          "title": "Freshness Window",
          "type": "string"
        },
        "object_schema_version": {
          "minLength": 1,
          "title": "Object Schema Version",
          "type": "string"
        },
        "role_target": {
