      "title": "K",
      "type": "integer"
    },
    "query_text": {
      "minLength": 1,
      "title": "Query Text",
      "type": "string"
    },
    "track": {
      "anyOf": [
        {
          "$ref": "#/$defs/CareerTrack"
        },
        {
          "type": "null"
        }
      ],
