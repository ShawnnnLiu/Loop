  "additionalProperties": false,
  "description": "One persisted user-facing prose output (append-only).\n\n``reason_code`` is a display *copy* of the run's typed cause \u2014 the run\nrecord stays authoritative; this record can never smuggle prose into\nrouting decisions.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "detail": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Detail",
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/ProseAttachmentKind"
    },
    "plan_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Version"
    },
    "prose_attachment_id": {
      "minLength": 1,
      "title": "Prose Attachment Id",
      "type": "string"
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasonCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "user_id": {
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    }
  },
  "required": [
    "prose_attachment_id",
    "user_id",
    "run_id",
    "kind",
    "summary",
    "created_at"
  ],
  "title": "ProseAttachmentRecord",
  "type": "object"
