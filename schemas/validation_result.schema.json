{
  "$defs": {
    "ArtifactType": {
      "description": "The kind of artifact a ``ValidationResult`` describes.",
      "enum": [
        "user_profile",
        "motivation_profile",
        "syllabus_units",
        "task_plan"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "NextAction": {
      "description": "Deterministic next step after a validation result.",
      "enum": [
        "scheduler",
        "planner_repair_retry",
        "strategist_repair_retry",
        "error_requires_user",
        "noop"
      ],
      "title": "NextAction",
      "type": "string"
    },
    "ReasonCode": {
      "description": "All typed failure / outcome codes in the system.\n\nCodes are uppercase ``SCREAMING_SNAKE_CASE`` strings so they survive a\nJSON round-trip unchanged and so they read identically in logs, telemetry,\nand user-facing explanations.",
      "enum": [
        "VALIDATION_FAILED",
        "SCHEMA_INVALID",
        "TASK_GRAPH_INVALID",
        "MODULE_COVERAGE_INSUFFICIENT",
        "USER_FIT_VIOLATED",
        "SCHEDULING_PRECONDITION_FAILED",
        "REPAIR_LIMIT_EXCEEDED",
        "FORBIDDEN_FIELD_PRESENT",
        "NO_VALID_CONTIGUOUS_BLOCK",
        "INSUFFICIENT_WEEKLY_CAPACITY",
        "DEPENDENCY_BLOCKED",
        "OUTSIDE_ALLOWED_HOURS",
        "DAILY_LOAD_EXCEEDED",
        "DEEP_WORK_REQUIRED_UNAVAILABLE",
        "TASK_TOO_LONG_UNSPLITTABLE",
        "TASK_TOO_LONG_SPLITTABLE",
        "DEPENDENCY_ADVISORY",
        "OVERLAP_ADVISORY",
        "DAILY_LOAD_ADVISORY",
        "TASK_DROPPED_BY_USER",
        "DEPENDENT_DROP_PRUNED",
        "INVALID_STATE_TRANSITION",
        "USER_APPROVAL_REQUIRED",
        "ERROR_REQUIRES_USER",
        "PROFILE_MAJOR_CHANGE",
        "CAPACITY_CHANGE",
        "APPROVAL_MISSING",
        "APPROVAL_EXPIRED",
        "APPROVAL_HASH_MISMATCH",
        "APPROVAL_HASH_ALGORITHM_UNSUPPORTED",
        "CALENDAR_WRITE_LOCK_BUSY",
        "CALENDAR_WRITE_LOCK_EXPIRED",
        "CALENDAR_WRITE_DUPLICATE_DETECTED",
        "CALENDAR_WRITE_FAILED",
        "CALENDAR_VERIFICATION_FAILED",
        "CALENDAR_ROLLBACK_FAILED",
        "EXTERNAL_SYNC_FAILED",
        "EXTERNAL_EVENT_DELETED",
        "DEEP_WORK_WINDOW_CONFLICT",
        "USER_DURATION_CALIBRATION",
        "DEPENDENCY_RESCHEDULED",
        "WEEKLY_CAPACITY_REBALANCE",
        "EXTERNAL_CALENDAR_CONFLICT",
        "USER_PROFILE_CHANGE",
        "DRIFT_REMEDIATION",
        "SPONSOR_REPORT_PENDING",
        "SPONSOR_PERMISSION_MISSING",
        "SPONSOR_VISIBILITY_VIOLATION",
        "ACCOUNTABILITY_CONTRACT_INACTIVE",
        "CHECKIN_DUE",
        "CHECKIN_MISSED",
        "MISSED_TASK_THRESHOLD_REACHED",
        "BEHIND_SCHEDULE_THRESHOLD_REACHED",
        "LOW_COMPLETION_RATE",
        "RECOVERY_PLAN_REQUIRED",
        "ACCOUNTABILITY_MISMATCH",
        "SPONSOR_PRESSURE_MISMATCH",
        "USER_RECOMMITMENT_REQUIRED",
        "DRIFT_CAPACITY_MISMATCH",
        "DRIFT_DURATION_UNDERESTIMATE",
        "DRIFT_DURATION_OVERESTIMATE",
        "DRIFT_TOPIC_AVOIDANCE",
        "DRIFT_EXTERNAL_CONFLICT",
        "DRIFT_LOW_ENGAGEMENT",
        "DRIFT_DEPENDENCY_BLOCKED",
        "DRIFT_CALENDAR_FRAGMENTATION",
        "SOURCE_CLAIM_VALIDATION_FAILED",
        "SOURCE_CLAIM_EXPIRED",
        "CONSENT_MISSING",
        "CONSENT_REVOKED",
        "DATA_EXPORTED",
        "DATA_DELETED",
        "POOLED_MODEL_UNAVAILABLE",
        "POOLED_BUCKET_SPARSE",
        "POWER_USER_TOTAL_COMPLETIONS_BELOW_THRESHOLD",
        "POWER_USER_CATEGORY_COMPLETIONS_BELOW_THRESHOLD",
        "POWER_USER_INSUFFICIENT_ASSESSABLE_WEEKS",
        "POWER_USER_COMPLETION_RATE_UNSTABLE",
        "PER_USER_REFINEMENT_UNAVAILABLE",
        "LLM_CALL_FAILED",
        "LLM_MALFORMED_OUTPUT",
        "LLM_SCHEMA_REJECTED",
        "LLM_REFUSAL",
        "LLM_TRUNCATED",
        "LLM_RETRY_LIMIT_EXCEEDED",
        "LLM_AUTH_FAILED",
        "LLM_RATE_LIMITED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "Violation": {
      "additionalProperties": false,
      "description": "One structured failure inside a ``ValidationResult``.\n\nThe shape carries a typed ``type`` plus arbitrary ``details`` so each\nchecker can attach the fields needed to repair the failure (e.g.\n``invalid_dependency`` for ``orphan_dependency``). Detail fields are\nintentionally loose because ``ViolationType`` is the contract surface;\nevery checker documents what it puts in ``details`` next to its code.",
      "properties": {
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "module_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Id"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "type": {
          "$ref": "#/$defs/ViolationType"
        }
      },
      "required": [
        "type"
      ],
      "title": "Violation",
      "type": "object"
    },
    "ViolationType": {
      "description": "Specific structured failures produced by validation checkers.",
      "enum": [
        "required_field_missing",
        "field_type_invalid",
        "enum_value_invalid",
        "numeric_out_of_range",
        "forbidden_field_present",
        "duplicate_task_id",
        "orphan_dependency",
        "cycle_detected",
        "self_dependency",
        "missing_module_id",
        "module_coverage_missing",
        "low_priority_module_overweighted",
        "duration_exceeds_user_max_session",
        "duration_far_from_preferred",
        "weekly_load_exceeds_capacity",
        "cognitive_load_out_of_range",
        "category_invalid",
        "focus_level_invalid",
        "high_load_tasks_not_distributed",
        "no_root_task",
        "orphan_source_claim",
        "expired_source_claim",
        "company_module_missing_claim"
      ],
      "title": "ViolationType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic pass/fail with typed reason and structured violations.",
  "properties": {
    "artifact_type": {
      "$ref": "#/$defs/ArtifactType"
    },
    "max_repair_attempts": {
      "default": 2,
      "maximum": 10,
      "minimum": 0,
      "title": "Max Repair Attempts",
      "type": "integer"
    },
    "next_action": {
      "$ref": "#/$defs/NextAction"
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasonCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repair_attempt": {
      "minimum": 0,
      "title": "Repair Attempt",
      "type": "integer"
    },
    "repairable": {
      "title": "Repairable",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    },
    "violations": {
      "items": {
        "$ref": "#/$defs/Violation"
      },
      "title": "Violations",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "artifact_type",
    "valid",
    "repairable",
    "repair_attempt",
    "next_action"
  ],
  "title": "ValidationResult",
  "type": "object"
}
