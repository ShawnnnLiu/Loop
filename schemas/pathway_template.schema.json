{
  "$defs": {
    "CareerTrack": {
      "description": "Closed set of supported career-preparation tracks.",
      "enum": [
        "swe",
        "mle",
        "ai_engineer",
        "quant_dev",
        "data_scientist",
        "product_manager",
        "data_analyst",
        "data_engineer"
      ],
      "title": "CareerTrack",
      "type": "string"
    },
    "EvidenceKind": {
      "description": "Closed classification of one confirmed evidence item.\n\nShared by ``ExperienceItem.kind`` (user-profile spec) and\n``EvidenceSlot.required_kinds`` (pathway-template spec). Closed for humans\ntoo: kinds are join keys for the deterministic ``narrative/`` kernel, so\nthe UI offers the same fixed dropdown the LLM proposal is bound to.",
      "enum": [
        "work",
        "project",
        "volunteering",
        "leadership",
        "research",
        "award",
        "coursework"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceSlot": {
      "additionalProperties": false,
      "description": "One pillar of a pathway: the evidence a coherent story needs there.\n\nAn evidence item matches a slot iff ``item.kind in required_kinds`` and\n``item.theme_tags`` intersect ``required_themes_any`` (the ``narrative/``\nkernel owns that computation, NP-B). ``gap_module_hint`` and\n``branch_skill_ids`` are display/seed data with no control-plane effect.",
      "properties": {
        "branch_skill_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Branch Skill Ids",
          "type": "array"
        },
        "gap_module_hint": {
          "minLength": 1,
          "title": "Gap Module Hint",
          "type": "string"
        },
        "min_items": {
          "default": 1,
          "maximum": 10,
          "minimum": 1,
          "title": "Min Items",
          "type": "integer"
        },
        "required_kinds": {
          "items": {
            "$ref": "#/$defs/EvidenceKind"
          },
          "minItems": 1,
          "title": "Required Kinds",
          "type": "array"
        },
        "required_themes_any": {
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Themes Any",
          "type": "array"
        },
        "slot_id": {
          "minLength": 1,
          "title": "Slot Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "slot_id",
        "title",
        "required_kinds",
        "required_themes_any",
        "gap_module_hint",
        "branch_skill_ids"
      ],
      "title": "EvidenceSlot",
      "type": "object"
    },
    "KnowledgeGroup": {
      "additionalProperties": false,
      "description": "A group waypoint: a clickable cluster of member skill nodes.",
      "properties": {
        "blurb": {
          "minLength": 1,
          "title": "Blurb",
          "type": "string"
        },
        "branch": {
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        },
        "group_id": {
          "pattern": "^kg-[a-z0-9-]+$",
          "title": "Group Id",
          "type": "string"
        },
        "member_node_ids": {
          "items": {
            "pattern": "^kn-[a-z0-9-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Member Node Ids",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "title",
        "branch",
        "blurb",
        "member_node_ids"
      ],
      "title": "KnowledgeGroup",
      "type": "object"
    },
    "KnowledgeMap": {
      "additionalProperties": false,
      "description": "A pathway's generated grouped map: groups + nodes, no edges.",
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/KnowledgeGroup"
          },
          "minItems": 1,
          "title": "Groups",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/KnowledgeNode"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "groups",
        "nodes"
      ],
      "title": "KnowledgeMap",
      "type": "object"
    },
    "KnowledgeNode": {
      "additionalProperties": false,
      "description": "One map node: a taxonomy-anchored ``skill`` or a branch-level ``capstone``.\n\nKind-conditional fields (enforced below):\n\n* ``skill`` requires ``skill_id``, ``group_id``, ``expected_minutes`` and\n  forbids ``evidence_slot_id`` / ``branch``.\n* ``capstone`` requires ``evidence_slot_id``, ``branch`` and forbids\n  ``skill_id`` / ``group_id`` / ``expected_minutes``.",
      "properties": {
        "blurb": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blurb"
        },
        "branch": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "evidence_slot_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Slot Id"
        },
        "expected_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Minutes"
        },
        "group_id": {
          "anyOf": [
            {
              "pattern": "^kg-[a-z0-9-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "kind": {
          "$ref": "#/$defs/KnowledgeNodeKind"
        },
        "node_id": {
          "pattern": "^kn-[a-z0-9-]+$",
          "title": "Node Id",
          "type": "string"
        },
        "skill_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Id"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "title",
        "kind"
      ],
      "title": "KnowledgeNode",
      "type": "object"
    },
    "KnowledgeNodeKind": {
      "description": "What a knowledge-map node represents (pathway-template spec, KT-A).\n\n``skill`` nodes are taxonomy-anchored and live in exactly one group;\n``capstone`` nodes are branch-level (one per evidence slot) and belong to\nno group. There are no other kinds and no edges between nodes.",
      "enum": [
        "skill",
        "capstone"
      ],
      "title": "KnowledgeNodeKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A curated narrative pathway for one :class:`CareerTrack`.",
  "properties": {
    "audience_note": {
      "minLength": 1,
      "title": "Audience Note",
      "type": "string"
    },
    "career_track": {
      "$ref": "#/$defs/CareerTrack"
    },
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "evidence_slots": {
      "items": {
        "$ref": "#/$defs/EvidenceSlot"
      },
      "minItems": 1,
      "title": "Evidence Slots",
      "type": "array"
    },
    "knowledge_map": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeMap"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pathway_id": {
      "minLength": 1,
      "title": "Pathway Id",
      "type": "string"
    },
    "pathway_schema_version": {
      "minLength": 1,
      "title": "Pathway Schema Version",
      "type": "string"
    },
    "spine": {
      "minLength": 1,
      "title": "Spine",
      "type": "string"
    }
  },
  "required": [
    "pathway_id",
    "pathway_schema_version",
    "career_track",
    "display_name",
    "spine",
    "audience_note",
    "evidence_slots"
  ],
  "title": "PathwayTemplate",
  "type": "object"
}
