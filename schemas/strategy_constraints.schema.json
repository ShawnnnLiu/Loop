{
  "$defs": {
    "KnowledgeNodeRef": {
      "additionalProperties": false,
      "description": "One trainable skill node on the account's knowledge map (KT-C).\n\nThe closed vocabulary the Strategist may tag modules against: ``node_id``\nplus the taxonomy ``title`` (a curated display name, never user free text).\nThe account's *pathway content* only - generated skill nodes plus\ntaxonomy-anchored additions; personal custom content never appears here (the\ninjection wall, ``06-knowledge-tree.md``).",
      "properties": {
        "node_id": {
          "pattern": "^kn-[a-z0-9-]+$",
          "title": "Node Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "title"
      ],
      "title": "KnowledgeNodeRef",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Priority",
      "type": "string"
    },
    "UnfilledSlot": {
      "additionalProperties": false,
      "description": "One unfilled evidence slot, projected from the selected pathway.\n\nA display/seed projection of ``EvidenceSlot`` (pathway-template spec):\n``gap_module_hint`` seeds module wording and is never control flow.",
      "properties": {
        "gap_module_hint": {
          "minLength": 1,
          "title": "Gap Module Hint",
          "type": "string"
        },
        "slot_id": {
          "minLength": 1,
          "title": "Slot Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "slot_id",
        "title",
        "gap_module_hint"
      ],
      "title": "UnfilledSlot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bounds on a Strategist proposal (spec defaults shown).",
  "properties": {
    "knowledge_nodes": {
      "items": {
        "$ref": "#/$defs/KnowledgeNodeRef"
      },
      "title": "Knowledge Nodes",
      "type": "array"
    },
    "max_modules": {
      "default": 12,
      "exclusiveMinimum": 0,
      "maximum": 100,
      "title": "Max Modules",
      "type": "integer"
    },
    "max_slot_modules": {
      "default": 3,
      "exclusiveMinimum": 0,
      "maximum": 10,
      "title": "Max Slot Modules",
      "type": "integer"
    },
    "max_total_estimated_minutes": {
      "default": 4800,
      "exclusiveMinimum": 0,
      "title": "Max Total Estimated Minutes",
      "type": "integer"
    },
    "must_reference_claims_for_company_specific_modules": {
      "default": true,
      "title": "Must Reference Claims For Company Specific Modules",
      "type": "boolean"
    },
    "pathway_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pathway Id"
    },
    "required_priority_values": {
      "items": {
        "$ref": "#/$defs/Priority"
      },
      "title": "Required Priority Values",
      "type": "array"
    },
    "unfilled_slots": {
      "items": {
        "$ref": "#/$defs/UnfilledSlot"
      },
      "title": "Unfilled Slots",
      "type": "array"
    }
  },
  "title": "StrategyConstraints",
  "type": "object"
}
