{
  "$defs": {
    "LlmNodeName": {
      "description": "The five allowed LLM nodes (axiom 01); no other caller may log here.",
      "enum": [
        "strategist",
        "planner",
        "reflection_summary",
        "user_facing_explanation",
        "resume_intake"
      ],
      "title": "LlmNodeName",
      "type": "string"
    },
    "ReasonCode": {
      "description": "All typed failure / outcome codes in the system.\n\nCodes are uppercase ``SCREAMING_SNAKE_CASE`` strings so they survive a\nJSON round-trip unchanged and so they read identically in logs, telemetry,\nand user-facing explanations.",
      "enum": [
        "VALIDATION_FAILED",
        "SCHEMA_INVALID",
        "TASK_GRAPH_INVALID",
        "MODULE_COVERAGE_INSUFFICIENT",
        "USER_FIT_VIOLATED",
        "SCHEDULING_PRECONDITION_FAILED",
        "REPAIR_LIMIT_EXCEEDED",
        "FORBIDDEN_FIELD_PRESENT",
        "NO_VALID_CONTIGUOUS_BLOCK",
        "INSUFFICIENT_WEEKLY_CAPACITY",
        "DEPENDENCY_BLOCKED",
        "OUTSIDE_ALLOWED_HOURS",
        "DAILY_LOAD_EXCEEDED",
        "DEEP_WORK_REQUIRED_UNAVAILABLE",
        "TASK_TOO_LONG_UNSPLITTABLE",
        "TASK_TOO_LONG_SPLITTABLE",
        "DEPENDENCY_ADVISORY",
        "OVERLAP_ADVISORY",
        "DAILY_LOAD_ADVISORY",
        "TASK_DROPPED_BY_USER",
        "DEPENDENT_DROP_PRUNED",
        "INVALID_STATE_TRANSITION",
        "USER_APPROVAL_REQUIRED",
        "ERROR_REQUIRES_USER",
        "PROFILE_MAJOR_CHANGE",
        "CAPACITY_CHANGE",
        "APPROVAL_MISSING",
        "APPROVAL_EXPIRED",
        "APPROVAL_HASH_MISMATCH",
        "APPROVAL_HASH_ALGORITHM_UNSUPPORTED",
        "CALENDAR_WRITE_LOCK_BUSY",
        "CALENDAR_WRITE_LOCK_EXPIRED",
        "CALENDAR_WRITE_DUPLICATE_DETECTED",
        "CALENDAR_WRITE_FAILED",
        "CALENDAR_VERIFICATION_FAILED",
        "CALENDAR_ROLLBACK_FAILED",
        "EXTERNAL_SYNC_FAILED",
        "EXTERNAL_EVENT_DELETED",
        "DEEP_WORK_WINDOW_CONFLICT",
        "USER_DURATION_CALIBRATION",
        "DEPENDENCY_RESCHEDULED",
        "WEEKLY_CAPACITY_REBALANCE",
        "EXTERNAL_CALENDAR_CONFLICT",
        "USER_PROFILE_CHANGE",
        "DRIFT_REMEDIATION",
        "SPONSOR_REPORT_PENDING",
        "SPONSOR_PERMISSION_MISSING",
        "SPONSOR_VISIBILITY_VIOLATION",
        "ACCOUNTABILITY_CONTRACT_INACTIVE",
        "CHECKIN_DUE",
        "CHECKIN_MISSED",
        "MISSED_TASK_THRESHOLD_REACHED",
        "BEHIND_SCHEDULE_THRESHOLD_REACHED",
        "LOW_COMPLETION_RATE",
        "RECOVERY_PLAN_REQUIRED",
        "ACCOUNTABILITY_MISMATCH",
        "SPONSOR_PRESSURE_MISMATCH",
        "USER_RECOMMITMENT_REQUIRED",
        "DRIFT_CAPACITY_MISMATCH",
        "DRIFT_DURATION_UNDERESTIMATE",
        "DRIFT_DURATION_OVERESTIMATE",
        "DRIFT_TOPIC_AVOIDANCE",
        "DRIFT_EXTERNAL_CONFLICT",
        "DRIFT_LOW_ENGAGEMENT",
        "DRIFT_DEPENDENCY_BLOCKED",
        "DRIFT_CALENDAR_FRAGMENTATION",
        "SOURCE_CLAIM_VALIDATION_FAILED",
        "SOURCE_CLAIM_EXPIRED",
        "CONSENT_MISSING",
        "CONSENT_REVOKED",
        "DATA_EXPORTED",
        "DATA_DELETED",
        "POOLED_MODEL_UNAVAILABLE",
        "POOLED_BUCKET_SPARSE",
        "POWER_USER_TOTAL_COMPLETIONS_BELOW_THRESHOLD",
        "POWER_USER_CATEGORY_COMPLETIONS_BELOW_THRESHOLD",
        "POWER_USER_INSUFFICIENT_ASSESSABLE_WEEKS",
        "POWER_USER_COMPLETION_RATE_UNSTABLE",
        "PER_USER_REFINEMENT_UNAVAILABLE",
        "PATHWAY_NOT_SELECTED",
        "UNKNOWN_PATHWAY_ID",
        "UNKNOWN_EVIDENCE_SLOT",
        "SLOT_MODULE_LIMIT_EXCEEDED",
        "PATHWAY_REGISTRY_VERSION_MISMATCH",
        "LLM_CALL_FAILED",
        "LLM_MALFORMED_OUTPUT",
        "LLM_SCHEMA_REJECTED",
        "LLM_REFUSAL",
        "LLM_TRUNCATED",
        "LLM_RETRY_LIMIT_EXCEEDED",
        "LLM_AUTH_FAILED",
        "LLM_RATE_LIMITED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ValidationOutcome": {
      "description": "Whether the call yielded output that passed boundary re-validation.",
      "enum": [
        "pass",
        "fail"
      ],
      "title": "ValidationOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One append-only observability record per provider API call.",
  "properties": {
    "attempt": {
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "cache_creation_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Cache Creation Tokens",
      "type": "integer"
    },
    "cache_hit": {
      "default": false,
      "title": "Cache Hit",
      "type": "boolean"
    },
    "cache_read_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Cache Read Tokens",
      "type": "integer"
    },
    "cost_estimate_usd": {
      "minimum": 0,
      "title": "Cost Estimate Usd",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "llm_call_log_id": {
      "minLength": 1,
      "title": "Llm Call Log Id",
      "type": "string"
    },
    "model_name": {
      "minLength": 1,
      "title": "Model Name",
      "type": "string"
    },
    "node": {
      "$ref": "#/$defs/LlmNodeName"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "plan_version": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Version"
    },
    "prompt_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Hash"
    },
    "prompt_version": {
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasonCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "refusal": {
      "default": false,
      "title": "Refusal",
      "type": "boolean"
    },
    "response_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Hash"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "sdk_retry": {
      "default": 0,
      "minimum": 0,
      "title": "Sdk Retry",
      "type": "integer"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    },
    "validation_outcome": {
      "$ref": "#/$defs/ValidationOutcome"
    }
  },
  "required": [
    "llm_call_log_id",
    "run_id",
    "node",
    "prompt_version",
    "model_name",
    "attempt",
    "input_tokens",
    "output_tokens",
    "cost_estimate_usd",
    "latency_ms",
    "validation_outcome",
    "created_at"
  ],
  "title": "LlmCallLog",
  "type": "object"
}
