[importlinter]
root_packages =
    agentic_calendar
include_external_packages = True

# ---------------------------------------------------------------------------
# Contract 1: LLM SDK isolation.
#
# Only `agentic_calendar.llm_nodes` (and `agentic_calendar.tools`, the operator
# CLI surface) may import LLM SDKs. This is the import-time enforcement of the
# axiom in `docs/axioms/01-system-boundaries.md`.
# ---------------------------------------------------------------------------
[importlinter:contract:llm-sdk-isolation]
name = LLM SDKs may only be imported by llm_nodes (and operator tools).
type = forbidden
source_modules =
    agentic_calendar.common
    agentic_calendar.contracts
    agentic_calendar.supervisor
    agentic_calendar.prerequisites
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.approval
    agentic_calendar.calendar_writer
    agentic_calendar.accountability
    agentic_calendar.telemetry
    agentic_calendar.drift
    agentic_calendar.duration_estimation
    agentic_calendar.source_claims
    agentic_calendar.cache
    agentic_calendar.templates
    agentic_calendar.consent
    agentic_calendar.identity
    agentic_calendar.disposition
    agentic_calendar.skill_taxonomy
forbidden_modules =
    openai
    anthropic
    cohere
    mistralai
# Note: import-linter does not support subpackages of external packages in
# ``forbidden_modules`` (so ``google.generativeai`` / ``google.genai`` cannot
# be listed here directly). Those — plus a broader SDK list — are enforced by
# the grep test ``tests/boundaries/test_import_linter_contracts.py``
# (``test_no_llm_sdk_imports_outside_llm_nodes_or_tools``).

# ---------------------------------------------------------------------------
# Contract 2: Layered architecture.
#
# Top-level regions (supervisor, validation, scheduler, planning, llm_nodes)
# must not import each other directly. They may depend on the shared
# kernels (`common`, `contracts`, `prerequisites`); cross-region data flow
# happens through `contracts/`. This keeps a fault localized: a regression
# in scheduler/ cannot reach into validation/.
# ---------------------------------------------------------------------------
[importlinter:contract:layered-regions]
name = Region packages must not import each other directly.
type = independence
modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.approval
    agentic_calendar.accountability
    agentic_calendar.telemetry
    agentic_calendar.drift
    agentic_calendar.consent
    agentic_calendar.identity
    agentic_calendar.disposition

# Note: `calendar_writer` is intentionally NOT in the independence set above.
# The Calendar Write Manager must import :class:`ApprovalEventStore` from
# the `approval` region (axiom 06 line 5 separates the approval service from
# the writer, but the writer reads from the store). Independence contracts
# are bidirectional, so adding `calendar_writer` to the set would block that
# import. We instead constrain `calendar_writer` via the
# `calendar-writer-is-leaf` forbidden contract below, which blocks every
# region except `approval`.

# ---------------------------------------------------------------------------
# Contract 4: Prerequisites is a shared kernel.
#
# `prerequisites` may depend on `common` and `contracts` only. It is the
# single deterministic source of "is this task ready?" and may be imported
# by any region; nothing inside it may reach back into a region.
# ---------------------------------------------------------------------------
[importlinter:contract:prerequisites-is-leaf]
name = prerequisites/ may only depend on common/ and contracts/.
type = forbidden
source_modules =
    agentic_calendar.prerequisites
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.accountability

# ---------------------------------------------------------------------------
# Contract 5: Calendar Writer leaf-deps.
#
# `calendar_writer` is the only writer to an external calendar (axiom 06
# line 18). It may depend on `common`, `contracts`, and `approval` (for
# the approval-event store). Every other region is forbidden.
# ---------------------------------------------------------------------------
[importlinter:contract:calendar-writer-is-leaf]
name = calendar_writer/ may only depend on common/, contracts/, and approval/.
type = forbidden
source_modules =
    agentic_calendar.calendar_writer
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.prerequisites
    agentic_calendar.accountability

# ---------------------------------------------------------------------------
# Contract 6: Approval leaf-deps.
#
# `approval` (the approval service per axiom 06 line 5) owns the approval-
# event store. It may depend only on `common` and `contracts`; importing the
# calendar writer or any other region would invert the approval ↔ writer
# direction and defeat the seam.
# ---------------------------------------------------------------------------
[importlinter:contract:approval-is-leaf]
name = approval/ may only depend on common/ and contracts/.
type = forbidden
source_modules =
    agentic_calendar.approval
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.prerequisites
    agentic_calendar.calendar_writer
    agentic_calendar.accountability

# ---------------------------------------------------------------------------
# Contract 3: Contracts package is leaf.
#
# `contracts` only depends on `common`. Nothing in contracts/ may import
# business-logic regions; otherwise a contract change ripples everywhere and
# the schemas stop being a stable boundary.
# ---------------------------------------------------------------------------
[importlinter:contract:contracts-is-leaf]
name = contracts/ may only depend on common/.
type = forbidden
source_modules =
    agentic_calendar.contracts
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.prerequisites
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.approval
    agentic_calendar.calendar_writer
    agentic_calendar.accountability

# ---------------------------------------------------------------------------
# Contract 7: Accountability leaf-deps.
#
# `accountability` (the Phase 3 sponsor-reporting slice of axiom 21) may depend
# only on `common` and `contracts`. It is a pure leaf: it imports no other
# region. Nothing in the system imports it yet — a future composition root
# (Phase 7) wires the generator/delivery from outside the region set, the same
# way calendar_writer/approval are assembled.
# ---------------------------------------------------------------------------
[importlinter:contract:accountability-is-leaf]
name = accountability/ may only depend on common/ and contracts/.
type = forbidden
source_modules =
    agentic_calendar.accountability
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.prerequisites
    agentic_calendar.calendar_writer
    agentic_calendar.approval
    agentic_calendar.telemetry
    agentic_calendar.drift
    agentic_calendar.duration_estimation

# ---------------------------------------------------------------------------
# Contract 8: Telemetry leaf-deps (Phase 4).
#
# `telemetry` (ingestion, store, metrics, calibration) may depend only on
# `common` and `contracts`. The drift classifier reads `TelemetryEvent`
# objects via `contracts/`, never this region — so the two stay independent.
# A composition root (operator CLIs / future app layer) wires telemetry from
# outside the region set.
# ---------------------------------------------------------------------------
[importlinter:contract:telemetry-is-leaf]
name = telemetry/ may only depend on common/ and contracts/.
type = forbidden
source_modules =
    agentic_calendar.telemetry
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.prerequisites
    agentic_calendar.calendar_writer
    agentic_calendar.approval
    agentic_calendar.accountability
    agentic_calendar.drift
    agentic_calendar.duration_estimation

# ---------------------------------------------------------------------------
# Contract 9: Drift leaf-deps (Phase 4).
#
# `drift` (the deterministic classifier + policy mapping) may depend on
# `common`, `contracts`, AND `prerequisites` (the shared "is this task ready?"
# kernel, reused to detect `dependency_blocked` drift). Every other region is
# forbidden. It must not import `telemetry`: it consumes `TelemetryEvent`
# contracts passed in by the caller.
# ---------------------------------------------------------------------------
[importlinter:contract:drift-is-leaf]
name = drift/ may only depend on common/, contracts/, and prerequisites/.
type = forbidden
source_modules =
    agentic_calendar.drift
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.calendar_writer
    agentic_calendar.approval
    agentic_calendar.accountability
    agentic_calendar.telemetry
    agentic_calendar.duration_estimation

# ---------------------------------------------------------------------------
# Contract 10: Duration-estimation kernel leaf-deps (Phase 4).
#
# `duration_estimation` is a shared kernel like `prerequisites`: it may depend
# only on `common` and `contracts`, and any region (notably `planning`, for the
# replan path) may import it. Nothing inside it may reach back into a region.
# It is intentionally NOT in the independence set so regions can import it.
# ---------------------------------------------------------------------------
[importlinter:contract:duration-estimation-is-leaf]
name = duration_estimation/ may only depend on common/ and contracts/.
type = forbidden
source_modules =
    agentic_calendar.duration_estimation
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.prerequisites
    agentic_calendar.calendar_writer
    agentic_calendar.approval
    agentic_calendar.accountability
    agentic_calendar.telemetry
    agentic_calendar.drift
    agentic_calendar.source_claims
    agentic_calendar.consent

# ---------------------------------------------------------------------------
# Contract 11: Source-claims kernel leaf-deps (Phase 5).
#
# `source_claims` is a shared kernel like `prerequisites`/`duration_estimation`:
# it may depend only on `common` and `contracts`, and any region (notably the
# future Strategist composition root, and `planning`) may import it. Nothing
# inside it may reach back into a region or another kernel. It is intentionally
# NOT in the independence set so regions can import it. It is the deterministic
# confidence scorer (axiom 08) — an LLM never assigns confidence.
# ---------------------------------------------------------------------------
[importlinter:contract:source-claims-is-leaf]
name = source_claims/ may only depend on common/ and contracts/.
type = forbidden
source_modules =
    agentic_calendar.source_claims
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.prerequisites
    agentic_calendar.calendar_writer
    agentic_calendar.approval
    agentic_calendar.accountability
    agentic_calendar.telemetry
    agentic_calendar.drift
    agentic_calendar.duration_estimation
    agentic_calendar.cache
    agentic_calendar.templates
    agentic_calendar.consent

# ---------------------------------------------------------------------------
# Contract 12: Cache kernel leaf-deps (Phase 5).
#
# `cache` (keys, store, invalidation) may depend only on `common` and
# `contracts`. It reads source claims through the `ClaimRegistry` *protocol* and
# the `SourceClaim` contract, never the `source_claims` kernel — so the two stay
# independent. The composition root (operator CLIs / future app layer) wires the
# cache to the claim store and Strategist from outside the region set.
# ---------------------------------------------------------------------------
[importlinter:contract:cache-is-leaf]
name = cache/ may only depend on common/ and contracts/.
type = forbidden
source_modules =
    agentic_calendar.cache
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.prerequisites
    agentic_calendar.calendar_writer
    agentic_calendar.approval
    agentic_calendar.accountability
    agentic_calendar.telemetry
    agentic_calendar.drift
    agentic_calendar.duration_estimation
    agentic_calendar.source_claims
    agentic_calendar.templates
    agentic_calendar.consent

# ---------------------------------------------------------------------------
# Contract 13: Templates kernel leaf-deps (Phase 5c).
#
# `templates` (the milestone-template registry) is a shared kernel like
# `source_claims`/`cache`: it may depend only on `common` and `contracts`, and a
# composition root may import it. Nothing inside it may reach back into a region
# or another kernel. Its canned templates are deterministic seeds; an LLM never
# authors one.
# ---------------------------------------------------------------------------
[importlinter:contract:templates-is-leaf]
name = templates/ may only depend on common/ and contracts/.
type = forbidden
source_modules =
    agentic_calendar.templates
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.prerequisites
    agentic_calendar.calendar_writer
    agentic_calendar.approval
    agentic_calendar.accountability
    agentic_calendar.telemetry
    agentic_calendar.drift
    agentic_calendar.duration_estimation
    agentic_calendar.source_claims
    agentic_calendar.cache
    agentic_calendar.consent

# ---------------------------------------------------------------------------
# Contract 14: Consent leaf-deps (Phase 6a).
#
# `consent` (consent records, data-access audit log, consent gate, data
# controls — ADR-0007) may depend only on `common` and `contracts`. It is a
# pure leaf: pooled training (6b) receives the consented user-id set from the
# composition root rather than importing this region, and the data-control
# CLIs pass user-scoped store views in from outside the region set.
# ---------------------------------------------------------------------------
[importlinter:contract:consent-is-leaf]
name = consent/ may only depend on common/ and contracts/.
type = forbidden
source_modules =
    agentic_calendar.consent
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.prerequisites
    agentic_calendar.calendar_writer
    agentic_calendar.approval
    agentic_calendar.accountability
    agentic_calendar.telemetry
    agentic_calendar.drift
    agentic_calendar.duration_estimation
    agentic_calendar.source_claims
    agentic_calendar.cache
    agentic_calendar.templates

# ---------------------------------------------------------------------------
# Contract 15: Identity leaf-deps (hosted multi-user frontend).
#
# `identity` (per-user Google sub->user_id mapping, encrypted OAuth token, and
# dedicated calendar id) may depend only on `common` and `contracts`. Like
# `consent`, it is a pure leaf imported solely by the composition root
# (`app/`): the web layer wires it, and the Google OAuth SDK stays in
# `tools/google_oauth_web.py` (the leaf never touches it). Encryption is the
# caller's job via `common.secrets`, so this region carries no crypto imports
# that a contract would need to govern.
# ---------------------------------------------------------------------------
[importlinter:contract:identity-is-leaf]
name = identity/ may only depend on common/ and contracts/.
type = forbidden
source_modules =
    agentic_calendar.identity
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.prerequisites
    agentic_calendar.calendar_writer
    agentic_calendar.approval
    agentic_calendar.accountability
    agentic_calendar.telemetry
    agentic_calendar.drift
    agentic_calendar.duration_estimation
    agentic_calendar.source_claims
    agentic_calendar.cache
    agentic_calendar.templates
    agentic_calendar.consent

# ---------------------------------------------------------------------------
# Contract 16: Disposition leaf-deps (completion / drop memory).
#
# `disposition` (the append-only completion/skip/drop store) may depend only on
# `common` and `contracts`. Like `accountability`/`telemetry`, it is a pure
# leaf: the composition root (`app/`) projects its records into
# `SchedulerInput.completed_task_ids` and the drag-to-adjust advisory check, and
# the data-control CLI deletes it — all from outside the region set. Nothing
# inside it may reach back into a region.
# ---------------------------------------------------------------------------
[importlinter:contract:disposition-is-leaf]
name = disposition/ may only depend on common/ and contracts/.
type = forbidden
source_modules =
    agentic_calendar.disposition
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.prerequisites
    agentic_calendar.calendar_writer
    agentic_calendar.approval
    agentic_calendar.accountability
    agentic_calendar.telemetry
    agentic_calendar.drift
    agentic_calendar.duration_estimation
    agentic_calendar.source_claims
    agentic_calendar.cache
    agentic_calendar.templates
    agentic_calendar.consent
    agentic_calendar.identity

# ---------------------------------------------------------------------------
# Contract 17: Skill-taxonomy kernel leaf-deps (résumé intake RI-B).
#
# `skill_taxonomy` (registry + normalizer over the checked-in controlled
# vocabulary, axiom 08 "Controlled Vocabularies") is a shared kernel like
# `source_claims`: it may depend only on `common` and `contracts`, and the
# service layer / composition root may import it. Nothing inside it may reach
# back into a region. It is intentionally NOT in the independence set so
# regions can import it.
# ---------------------------------------------------------------------------
[importlinter:contract:skill-taxonomy-is-leaf]
name = skill_taxonomy/ may only depend on common/ and contracts/.
type = forbidden
source_modules =
    agentic_calendar.skill_taxonomy
forbidden_modules =
    agentic_calendar.supervisor
    agentic_calendar.validation
    agentic_calendar.scheduler
    agentic_calendar.planning
    agentic_calendar.llm_nodes
    agentic_calendar.prerequisites
    agentic_calendar.calendar_writer
    agentic_calendar.approval
    agentic_calendar.accountability
    agentic_calendar.telemetry
    agentic_calendar.drift
    agentic_calendar.duration_estimation
    agentic_calendar.source_claims
    agentic_calendar.cache
    agentic_calendar.templates
    agentic_calendar.consent
    agentic_calendar.identity
    agentic_calendar.disposition

# ---------------------------------------------------------------------------
# Contract 18: LLM nodes never import the skill-taxonomy kernel.
#
# The ResumeIntakeNode's allowed weak-spot vocabulary and membership resolver
# arrive as PLAIN DATA (`ResumeIntakeInput.allowed_weak_spots`; an injected
# callable), wired by the service layer — the node never reads the vocabulary
# itself. This is the structural form of "the LLM never touches the
# vocabulary" (docs/specs/skill-taxonomy.schema.md).
# ---------------------------------------------------------------------------
[importlinter:contract:llm-nodes-no-skill-taxonomy]
name = llm_nodes/ must not import skill_taxonomy/.
type = forbidden
source_modules =
    agentic_calendar.llm_nodes
forbidden_modules =
    agentic_calendar.skill_taxonomy
