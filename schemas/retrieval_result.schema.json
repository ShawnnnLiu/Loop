{
  "$defs": {
    "CareerTrack": {
      "description": "Closed set of supported career-preparation tracks.",
      "enum": [
        "swe",
        "mle",
        "ai_engineer",
        "quant_dev",
        "data_scientist",
        "product_manager",
        "data_analyst"
      ],
      "title": "CareerTrack",
      "type": "string"
    },
    "RankedChunk": {
      "additionalProperties": false,
      "description": "One ranked chunk reference with provenance (text stays in the index).",
      "properties": {
        "breadcrumb": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Breadcrumb"
        },
        "chunk_id": {
          "pattern": "^chunk_[0-9a-f]{16}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "doc_id": {
          "pattern": "^doc_[0-9a-f]{16}$",
          "title": "Doc Id",
          "type": "string"
        },
        "end_char": {
          "minimum": 1,
          "title": "End Char",
          "type": "integer"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        }
      },
      "required": [
        "rank",
        "chunk_id",
        "doc_id",
        "ordinal",
        "score",
        "start_char",
        "end_char"
      ],
      "title": "RankedChunk",
      "type": "object"
    },
    "RetrievalQuery": {
      "additionalProperties": false,
      "description": "One deterministic retrieval request against a pinned snapshot.",
      "properties": {
        "k": {
          "maximum": 100,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "query_text": {
          "minLength": 1,
          "title": "Query Text",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "$ref": "#/$defs/CareerTrack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "query_text",
        "k"
      ],
      "title": "RetrievalQuery",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One query's ranked chunk references against one pinned snapshot.",
  "properties": {
    "query": {
      "$ref": "#/$defs/RetrievalQuery"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/RankedChunk"
      },
      "title": "Results",
      "type": "array"
    },
    "snapshot_id": {
      "pattern": "^snap_[0-9a-f]{16}$",
      "title": "Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "query"
  ],
  "title": "RetrievalResult",
  "type": "object"
}
