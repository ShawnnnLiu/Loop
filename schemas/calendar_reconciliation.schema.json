{
  "$defs": {
    "CalendarEditType": {
      "description": "How the live external event differs from our recorded placement.",
      "enum": [
        "unchanged",
        "moved",
        "resized",
        "deleted"
      ],
      "title": "CalendarEditType",
      "type": "string"
    },
    "CalendarEventDelta": {
      "additionalProperties": false,
      "description": "One mapped task's recorded-vs-observed difference and its disposition.",
      "properties": {
        "calendar_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calendar Event Id"
        },
        "change_type": {
          "$ref": "#/$defs/CalendarEditType"
        },
        "disposition": {
          "$ref": "#/$defs/ReconciliationDisposition"
        },
        "observed_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed End"
        },
        "observed_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Start"
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recorded_end": {
          "format": "date-time",
          "title": "Recorded End",
          "type": "string"
        },
        "recorded_start": {
          "format": "date-time",
          "title": "Recorded Start",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "calendar_event_id",
        "change_type",
        "recorded_start",
        "recorded_end",
        "observed_start",
        "observed_end",
        "disposition"
      ],
      "title": "CalendarEventDelta",
      "type": "object"
    },
    "ReasonCode": {
      "description": "All typed failure / outcome codes in the system.\n\nCodes are uppercase ``SCREAMING_SNAKE_CASE`` strings so they survive a\nJSON round-trip unchanged and so they read identically in logs, telemetry,\nand user-facing explanations.",
      "enum": [
        "VALIDATION_FAILED",
        "SCHEMA_INVALID",
        "TASK_GRAPH_INVALID",
        "MODULE_COVERAGE_INSUFFICIENT",
        "USER_FIT_VIOLATED",
        "SCHEDULING_PRECONDITION_FAILED",
        "REPAIR_LIMIT_EXCEEDED",
        "FORBIDDEN_FIELD_PRESENT",
        "NO_VALID_CONTIGUOUS_BLOCK",
        "INSUFFICIENT_WEEKLY_CAPACITY",
        "DEPENDENCY_BLOCKED",
        "OUTSIDE_ALLOWED_HOURS",
        "DAILY_LOAD_EXCEEDED",
        "DEEP_WORK_REQUIRED_UNAVAILABLE",
        "TASK_TOO_LONG_UNSPLITTABLE",
        "TASK_TOO_LONG_SPLITTABLE",
        "INVALID_STATE_TRANSITION",
        "USER_APPROVAL_REQUIRED",
        "ERROR_REQUIRES_USER",
        "PROFILE_MAJOR_CHANGE",
        "CAPACITY_CHANGE",
        "APPROVAL_MISSING",
        "APPROVAL_EXPIRED",
        "APPROVAL_HASH_MISMATCH",
        "APPROVAL_HASH_ALGORITHM_UNSUPPORTED",
        "CALENDAR_WRITE_LOCK_BUSY",
        "CALENDAR_WRITE_LOCK_EXPIRED",
        "CALENDAR_WRITE_DUPLICATE_DETECTED",
        "CALENDAR_WRITE_FAILED",
        "CALENDAR_VERIFICATION_FAILED",
        "CALENDAR_ROLLBACK_FAILED",
        "EXTERNAL_SYNC_FAILED",
        "EXTERNAL_EVENT_DELETED",
        "DEEP_WORK_WINDOW_CONFLICT",
        "USER_DURATION_CALIBRATION",
        "DEPENDENCY_RESCHEDULED",
        "WEEKLY_CAPACITY_REBALANCE",
        "EXTERNAL_CALENDAR_CONFLICT",
        "USER_PROFILE_CHANGE",
        "DRIFT_REMEDIATION",
        "SPONSOR_REPORT_PENDING",
        "SPONSOR_PERMISSION_MISSING",
        "SPONSOR_VISIBILITY_VIOLATION",
        "ACCOUNTABILITY_CONTRACT_INACTIVE",
        "CHECKIN_DUE",
        "CHECKIN_MISSED",
        "MISSED_TASK_THRESHOLD_REACHED",
        "BEHIND_SCHEDULE_THRESHOLD_REACHED",
        "LOW_COMPLETION_RATE",
        "RECOVERY_PLAN_REQUIRED",
        "ACCOUNTABILITY_MISMATCH",
        "SPONSOR_PRESSURE_MISMATCH",
        "USER_RECOMMITMENT_REQUIRED",
        "DRIFT_CAPACITY_MISMATCH",
        "DRIFT_DURATION_UNDERESTIMATE",
        "DRIFT_DURATION_OVERESTIMATE",
        "DRIFT_TOPIC_AVOIDANCE",
        "DRIFT_EXTERNAL_CONFLICT",
        "DRIFT_LOW_ENGAGEMENT",
        "DRIFT_DEPENDENCY_BLOCKED",
        "DRIFT_CALENDAR_FRAGMENTATION",
        "SOURCE_CLAIM_VALIDATION_FAILED",
        "SOURCE_CLAIM_EXPIRED",
        "CONSENT_MISSING",
        "CONSENT_REVOKED",
        "DATA_EXPORTED",
        "DATA_DELETED",
        "POOLED_MODEL_UNAVAILABLE",
        "POOLED_BUCKET_SPARSE",
        "POWER_USER_TOTAL_COMPLETIONS_BELOW_THRESHOLD",
        "POWER_USER_CATEGORY_COMPLETIONS_BELOW_THRESHOLD",
        "POWER_USER_INSUFFICIENT_ASSESSABLE_WEEKS",
        "POWER_USER_COMPLETION_RATE_UNSTABLE",
        "PER_USER_REFINEMENT_UNAVAILABLE",
        "LLM_CALL_FAILED",
        "LLM_MALFORMED_OUTPUT",
        "LLM_SCHEMA_REJECTED",
        "LLM_REFUSAL",
        "LLM_TRUNCATED",
        "LLM_RETRY_LIMIT_EXCEEDED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ReconciliationDisposition": {
      "description": "What the deterministic service did with a single delta.",
      "enum": [
        "unchanged",
        "adopted",
        "rejected",
        "flagged_deleted"
      ],
      "title": "ReconciliationDisposition",
      "type": "string"
    },
    "ReconciliationOutcome": {
      "description": "Roll-up of one reconciliation pull.",
      "enum": [
        "sync_disabled",
        "deferred",
        "no_change",
        "adopted",
        "flagged",
        "mixed"
      ],
      "title": "ReconciliationOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Outcome of one on-demand reconciliation pull for an active run.",
  "properties": {
    "adopted_draft_schedule_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adopted Draft Schedule Id"
    },
    "deltas": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CalendarEventDelta"
      },
      "title": "Deltas",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/ReconciliationOutcome"
    },
    "plan_version": {
      "minLength": 1,
      "title": "Plan Version",
      "type": "string"
    },
    "reconciled_at": {
      "format": "date-time",
      "title": "Reconciled At",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "target_calendar_id": {
      "minLength": 1,
      "title": "Target Calendar Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "plan_version",
    "reconciled_at",
    "target_calendar_id",
    "outcome"
  ],
  "title": "CalendarReconciliationResult",
  "type": "object"
}
