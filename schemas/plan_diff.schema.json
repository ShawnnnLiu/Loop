{
  "$defs": {
    "DiffChangeType": {
      "description": "Allowed values for ``TaskChange.change_type`` (spec lines 111-120).",
      "enum": [
        "added",
        "removed",
        "rescheduled",
        "duration_changed",
        "dependency_changed",
        "module_reassigned",
        "priority_changed",
        "unchanged"
      ],
      "title": "DiffChangeType",
      "type": "string"
    },
    "FieldChange": {
      "additionalProperties": false,
      "description": "Level 3 field-level diff (spec lines 122-145).",
      "properties": {
        "delta": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta"
        },
        "delta_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta Minutes"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "new_value": {
          "default": null,
          "title": "New Value"
        },
        "old_value": {
          "default": null,
          "title": "Old Value"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "field",
        "reason_code"
      ],
      "title": "FieldChange",
      "type": "object"
    },
    "PlanDiffSummary": {
      "additionalProperties": false,
      "description": "Level 1 headline (spec lines 89-99).",
      "properties": {
        "modules_affected": {
          "items": {
            "type": "string"
          },
          "title": "Modules Affected",
          "type": "array"
        },
        "net_weekly_load_change_min": {
          "title": "Net Weekly Load Change Min",
          "type": "integer"
        },
        "tasks_added": {
          "minimum": 0,
          "title": "Tasks Added",
          "type": "integer"
        },
        "tasks_removed": {
          "minimum": 0,
          "title": "Tasks Removed",
          "type": "integer"
        },
        "tasks_rescheduled": {
          "minimum": 0,
          "title": "Tasks Rescheduled",
          "type": "integer"
        },
        "tasks_with_duration_changes": {
          "minimum": 0,
          "title": "Tasks With Duration Changes",
          "type": "integer"
        },
        "timeline_change_days": {
          "title": "Timeline Change Days",
          "type": "integer"
        }
      },
      "required": [
        "tasks_added",
        "tasks_removed",
        "tasks_rescheduled",
        "tasks_with_duration_changes",
        "modules_affected",
        "net_weekly_load_change_min",
        "timeline_change_days"
      ],
      "title": "PlanDiffSummary",
      "type": "object"
    },
    "ReasonCode": {
      "description": "All typed failure / outcome codes in the system.\n\nCodes are uppercase ``SCREAMING_SNAKE_CASE`` strings so they survive a\nJSON round-trip unchanged and so they read identically in logs, telemetry,\nand user-facing explanations.",
      "enum": [
        "VALIDATION_FAILED",
        "SCHEMA_INVALID",
        "TASK_GRAPH_INVALID",
        "MODULE_COVERAGE_INSUFFICIENT",
        "USER_FIT_VIOLATED",
        "SCHEDULING_PRECONDITION_FAILED",
        "REPAIR_LIMIT_EXCEEDED",
        "FORBIDDEN_FIELD_PRESENT",
        "NO_VALID_CONTIGUOUS_BLOCK",
        "INSUFFICIENT_WEEKLY_CAPACITY",
        "DEPENDENCY_BLOCKED",
        "OUTSIDE_ALLOWED_HOURS",
        "DAILY_LOAD_EXCEEDED",
        "DEEP_WORK_REQUIRED_UNAVAILABLE",
        "TASK_TOO_LONG_UNSPLITTABLE",
        "TASK_TOO_LONG_SPLITTABLE",
        "INVALID_STATE_TRANSITION",
        "USER_APPROVAL_REQUIRED",
        "ERROR_REQUIRES_USER",
        "PROFILE_MAJOR_CHANGE",
        "CAPACITY_CHANGE",
        "APPROVAL_MISSING",
        "APPROVAL_EXPIRED",
        "APPROVAL_HASH_MISMATCH",
        "APPROVAL_HASH_ALGORITHM_UNSUPPORTED",
        "CALENDAR_WRITE_LOCK_BUSY",
        "CALENDAR_WRITE_LOCK_EXPIRED",
        "CALENDAR_WRITE_DUPLICATE_DETECTED",
        "CALENDAR_WRITE_FAILED",
        "CALENDAR_VERIFICATION_FAILED",
        "CALENDAR_ROLLBACK_FAILED",
        "EXTERNAL_SYNC_FAILED",
        "DEEP_WORK_WINDOW_CONFLICT",
        "USER_DURATION_CALIBRATION",
        "DEPENDENCY_RESCHEDULED",
        "WEEKLY_CAPACITY_REBALANCE",
        "EXTERNAL_CALENDAR_CONFLICT",
        "USER_PROFILE_CHANGE",
        "DRIFT_REMEDIATION"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "TaskChange": {
      "additionalProperties": false,
      "description": "Level 2 per-task summary (spec lines 101-109).",
      "properties": {
        "change_type": {
          "$ref": "#/$defs/DiffChangeType"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "user_facing_summary": {
          "minLength": 1,
          "title": "User Facing Summary",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "change_type",
        "user_facing_summary"
      ],
      "title": "TaskChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable, read-only diff between two plan versions.",
  "properties": {
    "computed_at": {
      "format": "date-time",
      "title": "Computed At",
      "type": "string"
    },
    "diff_id": {
      "minLength": 1,
      "title": "Diff Id",
      "type": "string"
    },
    "field_changes": {
      "items": {
        "$ref": "#/$defs/FieldChange"
      },
      "title": "Field Changes",
      "type": "array"
    },
    "from_plan_version": {
      "minLength": 1,
      "title": "From Plan Version",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/PlanDiffSummary"
    },
    "task_changes": {
      "items": {
        "$ref": "#/$defs/TaskChange"
      },
      "title": "Task Changes",
      "type": "array"
    },
    "to_plan_version": {
      "minLength": 1,
      "title": "To Plan Version",
      "type": "string"
    }
  },
  "required": [
    "diff_id",
    "from_plan_version",
    "to_plan_version",
    "computed_at",
    "summary",
    "task_changes",
    "field_changes"
  ],
  "title": "PlanDiff",
  "type": "object"
}
