{
  "$defs": {
    "SlotOverride": {
      "additionalProperties": false,
      "description": "One explicit item-to-slot assignment correcting the greedy default.\n\nThe item is identified the way the profile identifies ``experience``\nentries: the case-insensitive ``(title, organization)`` pair.",
      "properties": {
        "item_organization": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Organization"
        },
        "item_title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Item Title",
          "type": "string"
        },
        "slot_id": {
          "minLength": 1,
          "title": "Slot Id",
          "type": "string"
        }
      },
      "required": [
        "item_title",
        "slot_id"
      ],
      "title": "SlotOverride",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The user's confirmed pathway choice, pinned to a registry version.",
  "properties": {
    "pathway_id": {
      "minLength": 1,
      "title": "Pathway Id",
      "type": "string"
    },
    "pathway_registry_version": {
      "minLength": 1,
      "title": "Pathway Registry Version",
      "type": "string"
    },
    "selected_at": {
      "format": "date-time",
      "title": "Selected At",
      "type": "string"
    },
    "slot_overrides": {
      "items": {
        "$ref": "#/$defs/SlotOverride"
      },
      "title": "Slot Overrides",
      "type": "array"
    }
  },
  "required": [
    "pathway_id",
    "pathway_registry_version",
    "selected_at"
  ],
  "title": "PathwaySelection",
  "type": "object"
}
