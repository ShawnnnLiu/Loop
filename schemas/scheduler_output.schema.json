{
  "$defs": {
    "CalendarEventStatus": {
      "description": "Phase 1 only ever produces ``DRAFT_ONLY``.",
      "enum": [
        "draft_only"
      ],
      "title": "CalendarEventStatus",
      "type": "string"
    },
    "ReasonCode": {
      "description": "All typed failure / outcome codes in the system.\n\nCodes are uppercase ``SCREAMING_SNAKE_CASE`` strings so they survive a\nJSON round-trip unchanged and so they read identically in logs, telemetry,\nand user-facing explanations.",
      "enum": [
        "VALIDATION_FAILED",
        "SCHEMA_INVALID",
        "TASK_GRAPH_INVALID",
        "MODULE_COVERAGE_INSUFFICIENT",
        "USER_FIT_VIOLATED",
        "SCHEDULING_PRECONDITION_FAILED",
        "REPAIR_LIMIT_EXCEEDED",
        "FORBIDDEN_FIELD_PRESENT",
        "NO_VALID_CONTIGUOUS_BLOCK",
        "INSUFFICIENT_WEEKLY_CAPACITY",
        "DEPENDENCY_BLOCKED",
        "OUTSIDE_ALLOWED_HOURS",
        "DAILY_LOAD_EXCEEDED",
        "DEEP_WORK_REQUIRED_UNAVAILABLE",
        "TASK_TOO_LONG_UNSPLITTABLE",
        "TASK_TOO_LONG_SPLITTABLE",
        "DEPENDENCY_ADVISORY",
        "TASK_DROPPED_BY_USER",
        "DEPENDENT_DROP_PRUNED",
        "INVALID_STATE_TRANSITION",
        "USER_APPROVAL_REQUIRED",
        "ERROR_REQUIRES_USER",
        "PROFILE_MAJOR_CHANGE",
        "CAPACITY_CHANGE",
        "APPROVAL_MISSING",
        "APPROVAL_EXPIRED",
        "APPROVAL_HASH_MISMATCH",
        "APPROVAL_HASH_ALGORITHM_UNSUPPORTED",
        "CALENDAR_WRITE_LOCK_BUSY",
        "CALENDAR_WRITE_LOCK_EXPIRED",
        "CALENDAR_WRITE_DUPLICATE_DETECTED",
        "CALENDAR_WRITE_FAILED",
        "CALENDAR_VERIFICATION_FAILED",
        "CALENDAR_ROLLBACK_FAILED",
        "EXTERNAL_SYNC_FAILED",
        "EXTERNAL_EVENT_DELETED",
        "DEEP_WORK_WINDOW_CONFLICT",
        "USER_DURATION_CALIBRATION",
        "DEPENDENCY_RESCHEDULED",
        "WEEKLY_CAPACITY_REBALANCE",
        "EXTERNAL_CALENDAR_CONFLICT",
        "USER_PROFILE_CHANGE",
        "DRIFT_REMEDIATION",
        "SPONSOR_REPORT_PENDING",
        "SPONSOR_PERMISSION_MISSING",
        "SPONSOR_VISIBILITY_VIOLATION",
        "ACCOUNTABILITY_CONTRACT_INACTIVE",
        "CHECKIN_DUE",
        "CHECKIN_MISSED",
        "MISSED_TASK_THRESHOLD_REACHED",
        "BEHIND_SCHEDULE_THRESHOLD_REACHED",
        "LOW_COMPLETION_RATE",
        "RECOVERY_PLAN_REQUIRED",
        "ACCOUNTABILITY_MISMATCH",
        "SPONSOR_PRESSURE_MISMATCH",
        "USER_RECOMMITMENT_REQUIRED",
        "DRIFT_CAPACITY_MISMATCH",
        "DRIFT_DURATION_UNDERESTIMATE",
        "DRIFT_DURATION_OVERESTIMATE",
        "DRIFT_TOPIC_AVOIDANCE",
        "DRIFT_EXTERNAL_CONFLICT",
        "DRIFT_LOW_ENGAGEMENT",
        "DRIFT_DEPENDENCY_BLOCKED",
        "DRIFT_CALENDAR_FRAGMENTATION",
        "SOURCE_CLAIM_VALIDATION_FAILED",
        "SOURCE_CLAIM_EXPIRED",
        "CONSENT_MISSING",
        "CONSENT_REVOKED",
        "DATA_EXPORTED",
        "DATA_DELETED",
        "POOLED_MODEL_UNAVAILABLE",
        "POOLED_BUCKET_SPARSE",
        "POWER_USER_TOTAL_COMPLETIONS_BELOW_THRESHOLD",
        "POWER_USER_CATEGORY_COMPLETIONS_BELOW_THRESHOLD",
        "POWER_USER_INSUFFICIENT_ASSESSABLE_WEEKS",
        "POWER_USER_COMPLETION_RATE_UNSTABLE",
        "PER_USER_REFINEMENT_UNAVAILABLE",
        "LLM_CALL_FAILED",
        "LLM_MALFORMED_OUTPUT",
        "LLM_SCHEMA_REJECTED",
        "LLM_REFUSAL",
        "LLM_TRUNCATED",
        "LLM_RETRY_LIMIT_EXCEEDED",
        "LLM_AUTH_FAILED",
        "LLM_RATE_LIMITED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RepairOption": {
      "description": "Deterministic repair options the Scheduler may suggest.",
      "enum": [
        "split_large_tasks",
        "split_task",
        "extend_timeline",
        "reduce_scope",
        "increase_weekly_hours",
        "relax_allowed_hours",
        "ask_user"
      ],
      "title": "RepairOption",
      "type": "string"
    },
    "ScheduleStatus": {
      "enum": [
        "success",
        "partial_failure",
        "failed"
      ],
      "title": "ScheduleStatus",
      "type": "string"
    },
    "ScheduledTask": {
      "additionalProperties": false,
      "description": "One placement of a task in calendar time (draft only).",
      "properties": {
        "calendar_event_status": {
          "$ref": "#/$defs/CalendarEventStatus",
          "default": "draft_only"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "start",
        "end"
      ],
      "title": "ScheduledTask",
      "type": "object"
    },
    "UnscheduledTask": {
      "additionalProperties": false,
      "description": "A task the Scheduler could not place, with typed reason + debug.",
      "properties": {
        "debug": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "Debug",
          "type": "object"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "reason_code",
        "debug"
      ],
      "title": "UnscheduledTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Always-a-draft Scheduler output (see ``scheduler-output.schema.md``).",
  "properties": {
    "available_capacity_min": {
      "minimum": 0,
      "title": "Available Capacity Min",
      "type": "integer"
    },
    "largest_available_block_min": {
      "minimum": 0,
      "title": "Largest Available Block Min",
      "type": "integer"
    },
    "plan_version": {
      "minLength": 1,
      "title": "Plan Version",
      "type": "string"
    },
    "repair_options": {
      "items": {
        "$ref": "#/$defs/RepairOption"
      },
      "title": "Repair Options",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schedule_status": {
      "$ref": "#/$defs/ScheduleStatus"
    },
    "scheduled_tasks": {
      "items": {
        "$ref": "#/$defs/ScheduledTask"
      },
      "title": "Scheduled Tasks",
      "type": "array"
    },
    "unscheduled_tasks": {
      "items": {
        "$ref": "#/$defs/UnscheduledTask"
      },
      "title": "Unscheduled Tasks",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "plan_version",
    "schedule_status",
    "available_capacity_min",
    "largest_available_block_min"
  ],
  "title": "SchedulerOutput",
  "type": "object"
}
